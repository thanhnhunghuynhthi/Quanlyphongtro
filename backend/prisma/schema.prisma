generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. TÀI KHOẢN VÀ PHÂN QUYỀN (User)
// ==========================================
model User {
  id                 Int                    @id @default(autoincrement())
  username           String                 @unique
  password           String
  fullName           String
  role               String                 @default("TENANT") // OWNER, TENANT
  phone              String?
  email              String?
  avatar             String?
  isActive           Boolean                @default(true)
  mustChangePassword Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  tenantProfile      TenantProfile?
  auditLogs          AuditLog[]
  notificationRecipients NotificationRecipient[]
  maintenanceRequestsCreated MaintenanceRequest[] @relation("MaintenanceRequestCreator")
  maintenanceUpdates MaintenanceUpdate[]   @relation("MaintenanceUpdateAuthor")
}

// ==========================================
// 2. HỒ SƠ NGƯỜI THUÊ (TenantProfile)
// ==========================================
model TenantProfile {
  id                    Int        @id @default(autoincrement())
  userId                Int?       @unique
  user                  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName              String
  phone                 String     @unique
  email                 String?
  identityNumber        String     @unique // CCCD / CMND
  identityIssueDate     DateTime?
  identityIssuePlace    String?
  dateOfBirth           DateTime?
  gender                String?    // NAM, NU, KHAC
  hometown              String?    // Quê quán / Thường trú
  hasTemporaryResidence Boolean    @default(false) // Đã đăng ký tạm trú
  currentRoomId         Int?
  currentRoom           Room?      @relation(fields: [currentRoomId], references: [id])
  contracts             Contract[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

// ==========================================
// 3. KHU TRỌ & TÒA NHÀ (Property)
// ==========================================
model Property {
  id           Int      @id @default(autoincrement())
  code         String   @unique // KT-SKY, KT-GREEN
  name         String
  address      String
  city         String   @default("Hà Nội")
  district     String?
  description  String?
  managerName  String?
  managerPhone String?
  floors       Floor[]
  rooms        Room[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// 4. TẦNG (Floor)
// ==========================================
model Floor {
  id          Int      @id @default(autoincrement())
  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floorNumber Int
  name        String
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, floorNumber])
}

// ==========================================
// 5. PHÒNG TRỌ (Room)
// ==========================================
model Room {
  id                   Int                  @id @default(autoincrement())
  roomNumber           String
  propertyId           Int
  property             Property             @relation(fields: [propertyId], references: [id])
  floorId              Int
  floor                Floor                @relation(fields: [floorId], references: [id])
  area                 Float                @default(20.0) // m2
  basePrice            Float                @default(3000000) // VNĐ/tháng
  depositAmount        Float                @default(3000000) // VNĐ
  maxRenters           Int                  @default(2)
  status               String               @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  isPublic             Boolean              @default(true)
  description          String?
  isArchived           Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  images               RoomImage[]
  roomAmenities        RoomAmenity[]
  contracts            Contract[]
  tenants              TenantProfile[]
  meterReadings        MeterReading[]
  invoices             Invoice[]
  viewingAppointments ViewingAppointment[]
  maintenanceRequests  MaintenanceRequest[]

  @@unique([propertyId, roomNumber])
}

// ==========================================
// 6. HÌNH ẢNH PHÒNG (RoomImage)
// ==========================================
model RoomImage {
  id         Int      @id @default(autoincrement())
  roomId     Int
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  isCover    Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

// ==========================================
// 7. DANH MỤC TIỆN ÍCH (Amenity)
// ==========================================
model Amenity {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  icon          String?       // Tên Lucide icon (air-vent, flame, refrigerator, etc.)
  description   String?
  roomAmenities RoomAmenity[]
}

// ==========================================
// 8. TIỆN ÍCH PHÒNG (RoomAmenity)
// ==========================================
model RoomAmenity {
  id        Int     @id @default(autoincrement())
  roomId    Int
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenityId Int
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomId, amenityId])
}

// ==========================================
// 9. HỢP ĐỒNG THUÊ (Contract)
// ==========================================
model Contract {
  id               Int                @id @default(autoincrement())
  contractCode     String             @unique // HD-2026-P101
  roomId           Int
  room             Room               @relation(fields: [roomId], references: [id])
  tenantId         Int
  tenant           TenantProfile      @relation(fields: [tenantId], references: [id])
  startDate        DateTime
  endDate          DateTime
  actualEndDate    DateTime?
  rentalPrice      Float              // Giá thuê chụp tại thời điểm ký
  depositAmount    Float              // Tiền cọc đã nhận
  depositRefunded  Float?             // Tiền cọc hoàn trả
  depositDeducted  Float?             // Tiền cọc bị khấu trừ
  deductionReason  String?            // Lý do khấu trừ (hư hỏng, nợ phí...)
  status           String             @default("ACTIVE") // DRAFT, ACTIVE, EXPIRED, TERMINATED
  terms            String?
  note             String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  occupants        ContractOccupant[]
  contractServices ContractService[]
  invoices         Invoice[]
}

// ==========================================
// 10. NGƯỜI Ở CÙNG (ContractOccupant)
// ==========================================
model ContractOccupant {
  id                    Int      @id @default(autoincrement())
  contractId            Int
  contract              Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fullName              String
  phone                 String?
  identityNumber        String?
  relationship          String?  // BẠN_BÈ, VỢ_CHỒNG, ANH_EM, KHÁC
  hasTemporaryResidence Boolean  @default(false)
  createdAt             DateTime @default(now())
}

// ==========================================
// 11. DỊCH VỤ CHUNG (Service)
// ==========================================
model Service {
  id               Int               @id @default(autoincrement())
  code             String            @unique // ELEC, WATER, INTERNET, PARKING, CLEANING
  name             String
  unit             String            // kWh, m3, Tháng, Xe/Tháng, Người/Tháng
  defaultPrice     Float
  chargeType       String            @default("FIXED_PER_ROOM") // METERED, FIXED_PER_ROOM, PER_PERSON
  contractServices ContractService[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ==========================================
// 12. DỊCH VỤ HỢP ĐỒNG (ContractService)
// ==========================================
model ContractService {
  id          Int      @id @default(autoincrement())
  contractId  Int
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id])
  customPrice Float    // Snapshot đơn giá áp dụng
  quantity    Float    @default(1.0)

  @@unique([contractId, serviceId])
}

// ==========================================
// 13. CHỈ SỐ ĐIỆN NƯỚC (MeterReading)
// ==========================================
model MeterReading {
  id              Int       @id @default(autoincrement())
  roomId          Int
  room            Room      @relation(fields: [roomId], references: [id])
  period          String    // YYYY-MM
  oldElectricity  Int       @default(0)
  newElectricity  Int       @default(0)
  usedElectricity Int       @default(0)
  oldWater        Int       @default(0)
  newWater        Int       @default(0)
  usedWater       Int       @default(0)
  readingDate     DateTime  @default(now())
  recordedBy      String?
  invoices        Invoice[]

  @@unique([roomId, period])
}

// ==========================================
// 14. HÓA ĐƠN TIỀN PHÒNG & DỊCH VỤ (Invoice)
// ==========================================
model Invoice {
  id               Int                 @id @default(autoincrement())
  invoiceCode      String              @unique // HD-202611-P101
  roomId           Int
  room             Room                @relation(fields: [roomId], references: [id])
  contractId       Int
  contract         Contract            @relation(fields: [contractId], references: [id])
  meterReadingId   Int?
  meterReading     MeterReading?       @relation(fields: [meterReadingId], references: [id])
  period           String              // YYYY-MM
  issueDate        DateTime            @default(now())
  dueDate          DateTime
  roomAmount       Float               @default(0)
  servicesAmount   Float               @default(0)
  surcharge        Float               @default(0)
  discount         Float               @default(0)
  adjustmentReason String?
  totalAmount      Float               @default(0)
  paidAmount       Float               @default(0)
  remainingAmount  Float               @default(0)
  status           String              @default("ISSUED") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, CANCELLED
  isOverdue        Boolean             @default(false)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items            InvoiceItem[]
  payments         Payment[]
  submissions      PaymentSubmission[]

  @@unique([contractId, period])
}

// ==========================================
// 15. CHI TIẾT MỤC HÓA ĐƠN (InvoiceItem)
// ==========================================
model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemName  String
  itemType  String  // ROOM, ELECTRICITY, WATER, SERVICE, SURCHARGE, DISCOUNT
  unitPrice Float   // Snapshot đơn giá
  quantity  Float   @default(1.0)
  unit      String  // tháng, kWh, m3, xe...
  amount    Float
  notes     String?
}

// ==========================================
// 16. LỊCH SỬ THANH TOÁN (Payment)
// ==========================================
model Payment {
  id                   Int      @id @default(autoincrement())
  paymentCode          String   @unique // PT-202611-001
  invoiceId            Int
  invoice              Invoice  @relation(fields: [invoiceId], references: [id])
  amount               Float
  paymentMethod        String   @default("TRANSFER") // CASH, TRANSFER
  paymentDate          DateTime @default(now())
  receivedBy           String?
  transactionReference String?
  notes                String?
  createdAt            DateTime @default(now())
}

// ==========================================
// 17. MINH CHỨNG THANH TOÁN (PaymentSubmission)
// ==========================================
model PaymentSubmission {
  id              Int       @id @default(autoincrement())
  invoiceId       Int
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  tenantId        Int
  amount          Float
  bankName        String?
  transactionCode String?
  proofImageUrl   String?
  note            String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
}

// ==========================================
// 18. LỊCH XEM PHÒNG (ViewingAppointment)
// ==========================================
model ViewingAppointment {
  id              Int       @id @default(autoincrement())
  appointmentCode String    @unique // LH-2026-001
  roomId          Int
  room            Room      @relation(fields: [roomId], references: [id])
  fullName        String
  phone           String
  email           String?
  preferredDate   DateTime
  message         String?
  status          String    @default("PENDING") // PENDING, CONFIRMED, RESCHEDULED, COMPLETED, CANCELLED
  ownerNote       String?
  suggestedDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// 19. YÊU CẦU SỬA CHỮA (MaintenanceRequest)
// ==========================================
model MaintenanceRequest {
  id              Int                 @id @default(autoincrement())
  requestCode     String              @unique // SC-2026-001
  roomId          Int
  room            Room                @relation(fields: [roomId], references: [id])
  tenantId        Int?
  createdByUserId Int?
  createdByUser   User?               @relation("MaintenanceRequestCreator", fields: [createdByUserId], references: [id])
  title           String
  category        String              @default("ELECTRICAL") // ELECTRICAL, PLUMBING, APPLIANCE, FURNITURE, OTHER
  urgency         String              @default("NORMAL") // LOW, NORMAL, HIGH, EMERGENCY
  description     String
  imageUrl        String?
  status          String              @default("PENDING") // PENDING, RECEIVED, IN_PROGRESS, RESOLVED, REJECTED
  estimatedCost   Float               @default(0)
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  updates         MaintenanceUpdate[]
}

// ==========================================
// 20. NHẬT KÝ TIẾN ĐỘ SỬA CHỮA (MaintenanceUpdate)
// ==========================================
model MaintenanceUpdate {
  id              Int                @id @default(autoincrement())
  requestId       Int
  request         MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  updatedByUserId Int?
  updatedByUser   User?              @relation("MaintenanceUpdateAuthor", fields: [updatedByUserId], references: [id])
  status          String
  message         String
  createdAt       DateTime           @default(now())
}

// ==========================================
// 21. THÔNG BÁO (Notification)
// ==========================================
model Notification {
  id               Int                     @id @default(autoincrement())
  title            String
  content          String
  type             String                  @default("GENERAL") // GENERAL, PAYMENT_REMINDER, MAINTENANCE, RULES, EMERGENCY
  targetType       String                  @default("ALL") // ALL, PROPERTY, ROOM, INDIVIDUAL
  targetPropertyId Int?
  targetRoomId     Int?
  createdAt        DateTime                @default(now())

  recipients       NotificationRecipient[]
}

// ==========================================
// 22. NGƯỜI NHẬN THÔNG BÁO (NotificationRecipient)
// ==========================================
model NotificationRecipient {
  id             Int          @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([notificationId, userId])
}

// ==========================================
// 23. NHẬT KÝ HỆ THỐNG / KIỂM TOÁN (AuditLog)
// ==========================================
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // CREATE_CONTRACT, TERMINATE_CONTRACT, CREATE_INVOICE, RECORD_PAYMENT, UPDATE_METER, CHANGE_STATUS
  entity    String   // Contract, Invoice, Payment, Room, Maintenance
  entityId  String
  details   String?  // JSON hoặc mô tả
  ipAddress String?
  createdAt DateTime @default(now())
}
